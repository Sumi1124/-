# SourceDesk environment — example.
#
# SourceDesk never reads API keys from this file; keys are stored in the macOS
# Keychain and entered in Settings > AI Providers. This file only documents the
# identifiers used in-band, and helps automation/CI know what's expected.
#
# Copy to `.env` and fill in locally. Never commit your real `.env`.

# Anthropic (optional) — or enter it in Settings > AI Providers
ANTHROPIC_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# Brave Search (optional) — search.brave.com
BRAVE_API_KEY=

# Ollama base URL (optional, defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434